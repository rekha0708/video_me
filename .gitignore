.DS_Store
.env
.env.bak
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.local/
.docker-config/
dist/
build/
*.egg-info/

# Track B generated/runtime assets.
# LoRA weights are local training output — kept out of git entirely (large binaries).
loras/*.safetensors
loras/*.pt
loras/*.ckpt
# Voice reference files — tracked in git (small WAVs, ~1 MB each).
# Exclude any large generated/session audio that lands here.
voices/**/*.flac

# Local training output logs. Model weights are ignored above.
training_logs/

# musubi-tuner pre-cache (latents + text encoder outputs) — large binary files.
assets/*/training/cache/

# Service logs and published pipeline output — regenerated at runtime, not source.
logs/
review/

# Downloaded source videos — large binaries, not committed.
# downloads/*.mp4
# downloads/*.mkv
# downloads/*.webm
# downloads/*.avi
# downloads/*.mov
downloads/instagram/wan2.2_with_lipSync.mp4
downloads/instagram/wan2.2_with_museTalk_lipsync.mp4
# ignore the claude settings file, which contains the API key
.claude/settings.local.json
nohup.out